<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless news-table">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr class="news-row">
            {% if item.thumbnail %}
              <td class="news-thumb-cell" style="width: 80px;">
                <img src="{{ item.thumbnail | relative_url }}"
                     alt=""
                     class="news-thumb"
                     loading="lazy">
              </td>
            {% endif %}
            <th scope="row" class="news-date" style="width: {% if item.thumbnail %}18%{% else %}20%{% endif %}; vertical-align: top;">
              {{ item.date | date: '%b %d, %Y' }}
            </th>
            <td style="vertical-align: top;">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

<style>
  .news-thumb {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 4px;
  }
  .news-thumb-cell {
    padding-right: 0.75rem;
  }
</style>
